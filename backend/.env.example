# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=development

# Database. PostgreSQL (recommended):
#   DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/aitutor
# Copy an existing SQLite database into it once with: python -m app.cli copy-from-sqlite data/aitutor.db
DATABASE_URL=sqlite:///./data/aitutor.db

# Signing secret for login tokens. Generate with: python -m app.cli init-keys
JWT_SECRET=change-me-to-a-long-random-string

# Data-encryption keys are NOT stored here: they live in a separate key ring file
KEYRING_PATH=./keys/keyring.json

# Google Gemini (AI generation). Leave empty to run AI features in offline fallback mode.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
# auto = use Gemini when a key is set, fall back to offline templates on error; offline = never call Gemini
AI_MODE=auto

# Automation (default true): a PDF of CLOs/PLOs is extracted, approved, mapped and activated automatically;
# lessons are published at once and each student gets personal lectures and notes. Test questions are drafted by
# the AI but always need a teacher's approval (the diagnostic goes live once enough are approved).
# Everything stays in the review queue. false = a teacher approves each step.
AUTOMATION=true

# Only e-mail addresses on this domain may self-register as students
ALLOWED_EMAIL_DOMAIN=university.edu

# Front-end address used in e-mail links
FRONTEND_URL=https://localhost:5173
# Retries for temporary Gemini errors (503 overloaded / 429 rate limit), then these backup models in order
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
GEMINI_RETRIES=1
